  "cards": [
    {
      "dot": "cyan",
      "title": "Leakage boundary",
      "items": [
        "Engine groups stay separate across fit and validation",
        "Official test labels are reserved for final scoring",
        "Leave-one-out fitting excludes the target FD subset"
      ]
    },
    {
      "dot": "amber",
      "title": "Interpretation limits",
      "items": [
        "FD subsets are related simulator domains, not real fleets",
        "Sensor corruptions are controlled synthetic stress tests",
        "Short-history models and truncated inference are separate protocols",
        "Coverage under shift is observed, not guaranteed"
      ]
    }
  ]
