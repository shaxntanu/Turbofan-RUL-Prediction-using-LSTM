{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Turbofan RUL Research Pipeline",
    "output": "docs/turbofan-pipeline.html",
    "quality_profile": "showcase",
    "views": [
      { "id": "data-to-model", "label": "Data to model", "focus": ["cmapss", "quality_gate", "engine_split", "features", "model_selection"], "note": "Follow the train-only preprocessing and validation path." },
      { "id": "evaluation", "label": "Evaluation", "focus": ["model_selection", "research_outputs", "test_eval", "apps"], "note": "Trace model selection into evaluation and result delivery." },
      { "id": "quality-recovery", "label": "Quality recovery", "focus": ["cmapss", "quality_gate", "repair_data", "engine_split"], "note": "Correct invalid input before modeling." }
    ]
  },
  "lanes": [
    { "id": "pipeline", "label": "Data preparation, modeling + research outputs" }
  ],
  "mainPath": ["cmapss", "quality_gate", "engine_split", "features", "model_selection", "research_outputs", "test_eval", "apps"],
  "semanticChecks": {
    "allowedRoots": ["cmapss"],
    "allowedTerminals": ["apps"],
    "requiredPaths": [{ "from": "cmapss", "to": "apps" }]
  },
  "nodes": [
    { "id": "cmapss", "lane": "pipeline", "col": 0, "type": "database", "label": "NASA C-MAPSS", "sublabel": "4 subsets" },
    { "id": "quality_gate", "lane": "pipeline", "col": 1, "type": "security", "label": "Validate", "sublabel": "RUL labels" },
    { "id": "engine_split", "lane": "pipeline", "col": 2, "type": "backend", "label": "Split by unit", "sublabel": "engine-level" },
    { "id": "features", "lane": "pipeline", "col": 3, "type": "backend", "label": "Window data", "sublabel": "train-only fit" },
    { "id": "model_selection", "lane": "pipeline", "col": 4, "type": "backend", "label": "Ridge / LSTM", "sublabel": "validation MAE" },
    { "id": "research_outputs", "lane": "pipeline", "col": 5, "yOffset": -70, "type": "database", "label": "Research", "sublabel": "transfer + PCA" },
    { "id": "test_eval", "lane": "pipeline", "col": 5, "type": "backend", "label": "Test metrics", "sublabel": "errors + UQ" },
    { "id": "apps", "lane": "pipeline", "col": 5, "yOffset": 70, "type": "frontend", "label": "Web + app", "sublabel": "figures + scores" },
    { "id": "repair_data", "lane": "pipeline", "col": 1, "yOffset": 92, "type": "backend", "label": "Fix data", "sublabel": "revalidate" }
  ],
  "edges": [
    { "from": "cmapss", "to": "quality_gate", "role": "main" },
    { "from": "quality_gate", "to": "engine_split", "label": "valid", "role": "main", "variant": "emphasis" },
    { "from": "engine_split", "to": "features", "role": "main" },
    { "from": "features", "to": "model_selection", "role": "main" },
    { "from": "model_selection", "to": "research_outputs", "label": "selected on validation", "role": "main", "variant": "emphasis" },
    { "from": "research_outputs", "to": "test_eval", "role": "main" },
    { "from": "test_eval", "to": "apps", "role": "main", "variant": "emphasis" },
    { "from": "quality_gate", "to": "repair_data", "label": "invalid", "role": "error", "variant": "security" },
    { "from": "repair_data", "to": "engine_split", "label": "corrected", "role": "return", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Leakage Controls", "items": ["Engine-level split", "Train-only scaling", "Validation-first selection"] },
    { "dot": "cyan", "title": "Research Adaptations", "items": ["Subset transfer", "PCA screening", "Fractional-life stages"] },
    { "dot": "amber", "title": "Evidence Boundary", "items": ["Simulated proxy domains", "Different paper target", "No overhaul records"] }
  ]
}
